{
  "name": "contra",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:golden": "turbo run test:golden",
    "dev": "turbo run dev",
    "validate": "turbo run format:check check:deps lint typecheck test build test:golden",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm format && eslint --fix .",
    "report:motion": "node --import ./scripts/ts-src-resolve.mjs packages/contra/scripts/writeMotionReport.mjs",
    "traces:export": "node --import ./scripts/ts-src-resolve.mjs apps/web/scripts/writeTraces.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "corpus:crawl": "node scripts/corpus/crawl-callers-box.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
