// Butter — Gene Hubert, becket. From data/dances/butter.json:
// A1 (2) Shift left (6) Circle left 3/4 (8) Neighbor swing
// A2 (8) Long lines forward and back (8) Robins chain to partner
// B1 (16) Hey (WR;NL;MR;PL;WR;NL;MR)
// B2 (4) Partner balance (12) Partner swing
// The first time through has no shift: the circle takes the eight beats.
// The robins chain and the hey are not written yet: a partner swing stands
// in for the two, keeping the sixty-four beats and bringing each couple
// back together on the lark's side as the chain would.

module butter() {
  group becket(minor-sets = $minor-sets);
  card "Butter";
  repeat (7) {
    if (not $first-time) {
      progress();
    }
    if ($neighbor) {
      phrase(A1) {
        if ($first-time) {
          circle($minor-set, Left, places = 3, beats = 8);
        } else {
          shift($partner, Left);
          circle($minor-set, Left, places = 3, beats = 6);
        }
        swing($neighbor, beats = 8);
      }
      phrase(A2) {
        long-lines($neighbor, beats = 8);
        swing($partner, beats = 8);
      }
      phrase(B1) {
        swing($partner, beats = 16);
      }
      phrase(B2) {
        balance($partner);
        swing($partner, beats = 12);
      }
    } else {
      wait-out($partner, beats = 64);
    }
  }
}

// A phrase of sixteen beats: asserts the cursor on the way in and out, and
// says which one it is for the cards.
module phrase(which: Phrase) {
  match (which) {
    A1 => assert($beat == 0, "A1 starts the time through");
    A2 => assert($beat == 16, "A2 starts at beat 16");
    B1 => assert($beat == 32, "B1 starts at beat 32");
    B2 => assert($beat == 48, "B2 starts at beat 48");
  }
  children();
}
