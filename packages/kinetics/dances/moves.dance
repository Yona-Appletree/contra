// Every move the compiler knows: the $ variables it needs (its contract),
// the parameters a caller may say, and the figure IR it is. The IR's own
// parameters are matched by name — `hand`, `direction`, `places`, `beats` —
// and its counterpart is the first Place the contract names, its ring the
// first Group. A module with an `ir` line is a move.

module bow($partner: Place) {
  ir "bow";
}

module do-si-do($partner: Place) {
  ir "do-si-do";
}

module allemande($partner: Place, hand: Hand, amount: Number = 1, beats: Beats = 8) {
  ir "allemande";
}

module shift($partner: Place, direction: Turn = Left, beats: Beats = 2) {
  ir "shift";
}

module circle($minor-set: Group, direction: Turn = Left, places: Int = 4, beats: Beats = 8) {
  ir "circle";
}

module swing($partner: Place, beats: Beats = 8) {
  ir "swing";
}

module long-lines($neighbor: Place, beats: Beats = 8) {
  ir "long-lines";
}

module balance($partner: Place) {
  ir "balance";
}

module wait-out($partner: Place, beats: Beats = 64) {
  ir "wait-out";
}
