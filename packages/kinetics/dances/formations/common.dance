// What every contra formation is made of: a couple, side by side, the robin
// on the lark's right. 0.8 m between the two; the couple's own frame sits
// between them, facing the way they face.

formation couple() {
  place lark role Lark at translate(y = -0.4m);
  place robin role Robin at translate(y = 0.4m);
  anchor centre = midpoint(lark, robin);
  provide $partner: Place = other(me);
  provide $role: Role = role(me);
}
