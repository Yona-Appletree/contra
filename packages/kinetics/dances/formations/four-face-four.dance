// Four face four: lines of four — two couples side by side — facing lines of
// four across the set, progressing like a becket a whole line at a time.

module four() {
  group a = couple() at translate(y = -0.8m);
  group b = couple() at translate(y = 0.8m);
}

module minor-set() {
  anchor center = point(x = 0m, y = 0m);
  anchor across = line(through = center, along = Y);
  group ones = four() at translate(x = -0.64m);
  group twos = four() at translate(x = 0.64m) rotate(180);
  provide $neighbor: Place = opposite-role(other(me));
  provide $across: Place = across(me, across);
  provide $travel: Direction = if (index(me) == 0) Up else Down;
}

module major-set(minor-sets: Int = 2) {
  anchor up = direction(Up);
  for i in 0..2 * minor-sets - 1 {
    group minor-set() at translate(y = 1.6m * i) {
      if (i % 2 == 0) {
        dancers;
      }
    }
  }
  group out-top = four() at translate(x = 0.64m, y = -1.6m) rotate(180);
  group out-bottom = four() at translate(x = -0.64m, y = 3.2m * minor-sets - 1.6m);
  provide progress() {
    if ($minor-set) {
      $minor-set = along($minor-set, $travel) or (if ($travel is Up) out-top else out-bottom);
    } else if ($four == out-top) {
      $minor-set = last(minor-set, Up);
      $four = "twos";
    } else {
      $minor-set = last(minor-set, Down);
      $four = "ones";
    }
  }
}

module four-face-four(minor-sets: Int = 2) {
  group major-set(minor-sets = minor-sets);
}
