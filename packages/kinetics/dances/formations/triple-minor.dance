// Triple minor: three couples a set, improper along the hall. The ones face
// down and progress one couple place each time; the couple they pass steps
// up to be the threes of the set above, and the threes stay put to be the
// twos of the ones' new set. The sets are laid a couple place apart and
// every third starts filled. The twos' and threes' moves are an
// approximation to be checked with the user (notes).

module minor-set() {
  anchor center = point(x = 0m, y = 0m);
  group ones = couple(spacing = 1.28m) at translate(y = -0.8m) rotate(90);
  group twos = couple(spacing = 1.28m) at rotate(270);
  group threes = couple(spacing = 1.28m) at translate(y = 0.8m) rotate(270);
  provide $slot: Int = index(me);
  provide $n1: Place = opposite-role(child(if (index(me) == 0) 1 else 0));
  provide $n2: Place = opposite-role(child(if (index(me) == 0) 2 else if (index(me) == 1) 2 else 1));
  provide $neighbor: Place = $n1;
}

module major-set(minor-sets: Int = 2) {
  anchor down = direction(Down);
  for i in 0..3 * minor-sets - 2 {
    group minor-set() at translate(y = 0.8m * i) {
      if (i % 3 == 0) {
        dancers;
      }
    }
  }
  group out-bottom = couple(spacing = 1.28m) at translate(y = 2.4m * minor-sets - 0.8m) rotate(270);
  group out-top = couple(spacing = 1.28m) at translate(y = -1.6m) rotate(90);
  provide progress() {
    if ($minor-set) {
      if ($slot == 0) {
        $minor-set = along($minor-set, Down) or out-bottom;
      } else if ($slot == 1) {
        $minor-set = along(along($minor-set, Up), Up) or out-top;
        $couple = "threes";
      } else {
        // The threes stay put to be the twos of the ones' new set; at the
        // bottom there is no new set, and they wait where they are.
        let below = along($minor-set, Down);
        if (below) {
          $minor-set = below;
          $couple = "twos";
        }
      }
    } else if ($couple == out-top) {
      $minor-set = last(minor-set, Up);
      $couple = "ones";
    } else {
      $minor-set = last(minor-set, Down);
      $couple = "threes";
    }
  }
}

module triple-minor(minor-sets: Int = 2) {
  group major-set(minor-sets = minor-sets);
}
