// A big circle (a Sicilian circle): couples facing couples around a ring,
// improper along the ring. The ones progress clockwise round it and the twos
// the other way; nobody is ever out. The ring is sized so that couples are a
// dancer place apart along it.

formation minor-set() {
  anchor centre = point(x = 0m, y = 0m);
  group ones = couple(spacing = 1.28m) at translate(y = -0.4m) rotate(90);
  group twos = couple(spacing = 1.28m) at translate(y = 0.4m) rotate(270);
  provide $neighbor: Place = opposite-role(other(me));
}

formation big-circle(minor-sets: Int = 4) {
  anchor centre = point(x = 0m, y = 0m);
  let n = 2 * minor-sets;
  let r = 0.8m * n / (2 * pi);
  repeat (i in n) group minor-set() at rotate(360 / n * i) translate(x = r);
  seat = alternate(minor-set);
  next = circle-progression(around = centre);
}
