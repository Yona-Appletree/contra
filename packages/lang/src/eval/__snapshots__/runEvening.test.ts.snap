exports[`runEvening > improper > lays its own floor under the same names, and progresses on it 1`] = `
"MajorSet(1) [x=0.000 y=0.000 h=0] {
  anchor up = direction(Up)
  Station(OutTop) [x=0.000 y=-2.000 h=0] {
    Couple(Ones) [x=0.000 y=-2.000 h=0] {
      Role(Lark) [x=-0.400 y=-2.000 h=0] { 1-2L }
      Role(Robin) [x=0.400 y=-2.000 h=0] { 1-2R }
    }
  }
  Station(In) [x=0.000 y=0.000 h=0] {
    MinorSet(0) [x=0.000 y=-0.800 h=0] {
      anchor across = line(through = point(0.000, -0.800), along = X)
      Couple(Ones) [x=0.000 y=-1.200 h=0] {
        Role(Lark) [x=-0.400 y=-1.200 h=0] { empty }
        Role(Robin) [x=0.400 y=-1.200 h=0] { empty }
      }
      Couple(Twos) [x=0.000 y=-0.400 h=180] {
        Role(Lark) [x=0.400 y=-0.400 h=180] { empty }
        Role(Robin) [x=-0.400 y=-0.400 h=180] { empty }
      }
    }
    MinorSet(1) [x=0.000 y=0.000 h=0] {
      anchor across = line(through = point(0.000, 0.000), along = X)
      Couple(Ones) [x=0.000 y=-0.400 h=0] {
        Role(Lark) [x=-0.400 y=-0.400 h=0] { OT-1L }
        Role(Robin) [x=0.400 y=-0.400 h=0] { OT-1R }
      }
      Couple(Twos) [x=0.000 y=0.400 h=180] {
        Role(Lark) [x=0.400 y=0.400 h=180] { 3-2L }
        Role(Robin) [x=-0.400 y=0.400 h=180] { 3-2R }
      }
    }
    MinorSet(2) [x=0.000 y=0.800 h=0] {
      anchor across = line(through = point(0.000, 0.800), along = X)
      Couple(Ones) [x=0.000 y=0.400 h=0] {
        Role(Lark) [x=-0.400 y=0.400 h=0] { empty }
        Role(Robin) [x=0.400 y=0.400 h=0] { empty }
      }
      Couple(Twos) [x=0.000 y=1.200 h=180] {
        Role(Lark) [x=0.400 y=1.200 h=180] { empty }
        Role(Robin) [x=-0.400 y=1.200 h=180] { empty }
      }
    }
    MinorSet(3) [x=0.000 y=1.600 h=0] {
      anchor across = line(through = point(0.000, 1.600), along = X)
      Couple(Ones) [x=0.000 y=1.200 h=0] {
        Role(Lark) [x=-0.400 y=1.200 h=0] { 1-1L }
        Role(Robin) [x=0.400 y=1.200 h=0] { 1-1R }
      }
      Couple(Twos) [x=0.000 y=2.000 h=180] {
        Role(Lark) [x=0.400 y=2.000 h=180] { OB-2L }
        Role(Robin) [x=-0.400 y=2.000 h=180] { OB-2R }
      }
    }
    MinorSet(4) [x=0.000 y=2.400 h=0] {
      anchor across = line(through = point(0.000, 2.400), along = X)
      Couple(Ones) [x=0.000 y=2.000 h=0] {
        Role(Lark) [x=-0.400 y=2.000 h=0] { empty }
        Role(Robin) [x=0.400 y=2.000 h=0] { empty }
      }
      Couple(Twos) [x=0.000 y=2.800 h=180] {
        Role(Lark) [x=0.400 y=2.800 h=180] { empty }
        Role(Robin) [x=-0.400 y=2.800 h=180] { empty }
      }
    }
  }
  Station(OutBottom) [x=0.000 y=3.600 h=180] {
    Couple(Twos) [x=0.000 y=3.600 h=180] {
      Role(Lark) [x=0.400 y=3.600 h=180] { 3-1L }
      Role(Robin) [x=-0.400 y=3.600 h=180] { 3-1R }
    }
  }
}"
