// contra.dance — what every contra formation shares: the two roles, the
// couple, the phrase, and the moves. A formation imports it and declares the
// rest (design §3, §8).
//
// Beats are a plain count, not a unit (notes D1): `beats: i32 = 8`.

group Role {
  id: enum { Lark, Robin }
  seated: Bool = true
  body { if (seated) dancer(); }
}

group Couple {
  id: enum { Ones, Twos }
  seated: Bool = true
  spacing: Length = 0.8m
  body {
    left(spacing / 2)  Role(Lark,  seated = seated);
    right(spacing / 2) Role(Robin, seated = seated);
  }
  partner = other(Role);
}

enum Phrase { A1, A2, B1, B2 }

// A function with a trailing block wraps a phrase, and the assert turns a
// phrase boundary into a diagnostic (§6).
fn phrase(which: Phrase, body: fn) {
  assert(beat == match which { A1 => 0, A2 => 16, B1 => 32, B2 => 48 });
  body();
}

// The moves: a `fn` with an `ir` in it is a leaf the kinematics can play, and
// its parameters are its contract. The bodies are still TypeScript (§7).

fn bow(with: Role, beats: i32 = 4) { ir "bow"; }

// A becket's shift is danced by the couple as one — the two slide along
// their line together — so the move names the partner it slides with, the
// way the swing names who it swings. A move that names nobody where its
// figure wants somebody is a `K002` from the join, and the dancers stand.
fn shift(direction: Turn, with: Role = partner, beats: i32 = 2) { ir "shift"; }

fn circle(ring: group, direction: Turn, places: i32 = 4, beats: i32 = 8) { ir "circle"; }

fn swing(with: Role, beats: i32 = 8) { ir "swing"; }

fn long-lines(across: Role, beats: i32 = 8) { ir "long-lines"; }

fn chain(who: enum Role, to: Role, beats: i32 = 8) { ir "chain"; }

fn hey(ring: group, start: enum Role, shoulder: Hand, beats: i32 = 16) { ir "hey"; }

fn balance(with: Role, beats: i32 = 4) { ir "balance"; }

fn wait-out(with: Role = partner, beats: i32 = 64) { ir "wait-out"; }

// `amount` is turns: an allemande right three quarters is `amount = 3/4`.
fn allemande(with: Role, hand: Hand, amount: f64 = 1, beats: i32 = 8) { ir "allemande"; }

fn do-si-do(with: Role, beats: i32 = 8) { ir "do-si-do"; }

fn promenade(ring: group, beats: i32 = 8) { ir "promenade"; }

// Robins on a Wire's figures (the kinetics-on-lang plan, M3).
//
// A `Role` argument may name nobody (notes D10): the robin at the end of the
// long wave has no far mate, and `form-wave(right = wave-mate, …)` there is a
// wave with one hand free — the figure's own cast rule says so. `stand` is
// what the other role does while one role dances a `||` (D11): the larks
// while the robins walk forward into the wave.

// The two beside each other, facing across, circulate around each other
// keeping that facing: a sideways do-si-do, eyes across the set. `Left` is
// the way a circle left goes (clockwise seen from above), `Right` the other.
fn mad-robin(around: Role, direction: Turn, beats: i32 = 6) { ir "mad-robin"; }

// Walk forward to the centre line and take a hand to each side, right to
// `right` and left to `left` — either may be nobody.
fn form-wave(right: Role, left: Role, beats: i32 = 2) { ir "form-wave"; }

// Balance in the wave you formed, the same hands.
fn balance-wave(right: Role, left: Role, beats: i32 = 4) { ir "balance-wave"; }

// The ring in single file, each facing along it, no hands, `eighths` of the
// way round.
fn single-file-promenade(ring: group, direction: Turn, eighths: i32, beats: i32 = 4) { ir "single-file-promenade"; }

// A gypsy: orbit each other by the named shoulder, eyes locked, no hands.
fn shoulder-round(with: Role, shoulder: Hand, amount-quarters: i32 = 4, beats: i32 = 8) { ir "shoulder-round"; }

fn stand(beats: i32 = 4) { ir "stand"; }
