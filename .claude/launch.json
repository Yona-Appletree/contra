{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spikes",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1"],
      "port": 8765
    },
    {
      "name": "storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@caller/storybook", "dev"],
      "port": 6006
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@caller/web", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "kinetics-debugger",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@caller/kinetics", "dev"],
      "port": 5177
    }
  ]
}
