  },
  "dependencies": {
    "@caller/choreo": "workspace:*",
    "@caller/contra": "workspace:*",
    "@caller/core": "workspace:*",
    "@caller/hall": "workspace:*",
    "@caller/music": "workspace:*",
    "@caller/ui-base": "workspace:*",
    "@caller/ui-design": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0"
  }
